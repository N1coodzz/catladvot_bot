# Токен, полученный у @BotFather. Не отправляйте его другим людям.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN

# Telegram ID двух владельцев, через запятую. Как узнать ID — в README.md.
ADMIN_IDS=111111111,222222222

# Как часто проверять сделки (секунды). По умолчанию 15.
POLL_INTERVAL=15

# Для запуска без Docker. В Docker путь задаётся отдельно.
DB_PATH=data/bot.sqlite3
